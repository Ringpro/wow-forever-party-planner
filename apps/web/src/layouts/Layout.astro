---
interface Props {
  title: string;
}
const { title } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Party Planner</title>
  </head>
  <body>
    <header>
      <a href={user ? "/app" : "/"} class="brand">Party Planner</a>
      <nav>
        <a href="/get">Get the tools</a>
        {user ? (
          <form method="post" action="/auth/logout">
            <button class="link" type="submit">Log out</button>
          </form>
        ) : (
          <a href="/auth/discord">Log in</a>
        )}
      </nav>
    </header>
    <main>
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    --bg: #f7f6f3;
    --fg: #1d1c1a;
    --muted: #6b6862;
    --card: #ffffff;
    --border: #e2dfd8;
    --accent: #5865f2;
    --accent-fg: #ffffff;
    --yes: #2e8b57;
    --maybe: #d9a521;
    --no: #b5473a;
    --danger: #b5473a;
    color-scheme: light dark;
  }
  @media (prefers-color-scheme: dark) {
    :root {
      --bg: #17171a;
      --fg: #ecebe8;
      --muted: #a29f98;
      --card: #212125;
      --border: #34343a;
      --accent: #8b95ff;
      --danger: #e0786b;
    }
  }
  * {
    box-sizing: border-box;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--fg);
    font: 16px/1.5 system-ui, sans-serif;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 16px;
    border-bottom: 1px solid var(--border);
  }
  header a {
    color: inherit;
    text-decoration: none;
  }
  .brand {
    font-weight: 700;
  }
  main {
    max-width: 640px;
    margin: 0 auto;
    padding: 24px 16px 48px;
  }
  .card {
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 16px;
    margin-bottom: 16px;
  }
  .button {
    display: inline-block;
    min-height: 44px;
    padding: 10px 16px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--accent-fg);
    font-weight: 600;
    text-decoration: none;
  }
  .button[aria-disabled="true"] {
    opacity: 0.5;
    pointer-events: none;
  }
  .muted {
    color: var(--muted);
  }
  nav {
    display: flex;
    gap: 16px;
    align-items: center;
  }
  nav form {
    margin: 0;
  }
  h1 {
    font-size: 1.6rem;
    line-height: 1.25;
    margin: 0 0 8px;
  }
  a {
    color: var(--accent);
  }
  .button.secondary {
    background: transparent;
    color: var(--fg);
    border: 1px solid var(--border);
  }
  .button.danger {
    background: transparent;
    color: var(--danger);
    border: 1px solid var(--danger);
  }
  button {
    font: inherit;
    cursor: pointer;
  }
  button.button {
    border: 0;
  }
  button.link {
    background: none;
    border: 0;
    padding: 0;
    color: var(--accent);
  }
  input,
  select {
    font: inherit;
    min-height: 44px;
    padding: 8px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--fg);
    max-width: 100%;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }
  label.check {
    flex-direction: row;
    align-items: center;
    gap: 8px;
  }
  label.check input {
    min-height: auto;
    width: 20px;
    height: 20px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .stack h2,
  .stack h3 {
    margin: 0;
  }
  .error,
  .notice {
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid var(--danger);
  }
  .notice {
    border-color: var(--maybe);
  }
  .day-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 8px;
    flex-wrap: wrap;
  }
  .times {
    display: flex;
    gap: 12px;
    margin: 12px 0;
  }
  .status-buttons {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
  }
  .status {
    min-height: 44px;
    min-width: 72px;
    padding: 8px 12px;
    border-radius: 8px;
    border: 1px solid var(--border);
    background: var(--card);
    color: var(--fg);
    font-weight: 600;
  }
  .status[aria-pressed="true"].yes {
    background: var(--yes);
    border-color: var(--yes);
    color: #fff;
  }
  .status[aria-pressed="true"].maybe {
    background: var(--maybe);
    border-color: var(--maybe);
    color: #1d1c1a;
  }
  .status[aria-pressed="true"].no {
    background: var(--no);
    border-color: var(--no);
    color: #fff;
  }
  .pill {
    display: inline-block;
    padding: 2px 8px;
    border-radius: 999px;
    font-size: 0.875rem;
    border: 1px solid var(--border);
    white-space: nowrap;
  }
  .pill.yes {
    border-color: var(--yes);
  }
  .pill.maybe {
    border-color: var(--maybe);
  }
  .pill.no {
    border-color: var(--no);
  }
  .best {
    margin: 8px 0;
    font-weight: 600;
  }
  .best.none {
    color: var(--muted);
    font-weight: 400;
  }
  ul.members,
  ul.group-list {
    list-style: none;
    padding: 0;
    margin: 8px 0 0;
  }
  ul.members li {
    display: flex;
    gap: 8px;
    align-items: center;
    padding: 4px 0;
  }
  ul.members li.unknown,
  ul.members li.no {
    color: var(--muted);
  }
  ul.group-list li {
    padding: 8px 0;
  }
  input.invite {
    width: 100%;
    margin: 8px 0;
  }
</style>
