---
interface Props {
  title: string;
  active?: "overview" | "schedule" | "characters" | "tools";
}
const { title, active } = Astro.props;
const user = Astro.locals.user;
const initials = user?.displayName
  .split(/s+/)
  .map((w) => w[0])
  .join("")
  .slice(0, 2)
  .toUpperCase();
const current = (key: Props["active"]) => (active === key ? "page" : undefined);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14161c" />
    <title>{title} · Muster</title>
    <link rel="icon" href="/muster.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Cinzel:wght@700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body class={user ? "signed-in" : undefined}>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href={user ? "/app" : "/"} class="brand">
          <img src="/muster.svg" width="30" height="30" alt="" />
          <span>Muster</span>
        </a>
        <nav class="top-nav" aria-label="Main">
          {user && (
            <>
              <a href="/app" aria-current={current("overview")}>Overview</a>
              <a href="/app/schedule" aria-current={current("schedule")}>My schedule</a>
              <a href="/app/characters" aria-current={current("characters")}>Characters</a>
            </>
          )}
          <a href="/get" aria-current={current("tools")}>Tools</a>
          {user ? (
            <details class="account">
              <summary aria-label={`Account: ${user.displayName}`}><span class="avatar">{initials}</span></summary>
              <div class="account-menu">
                <span class="muted small">{user.displayName}</span>
                <a href="/onboarding?return_to=/app">Time zone</a>
                <a href="/app/account">Account</a>
                <form method="post" action="/auth/logout"><button class="link" type="submit">Log out</button></form>
              </div>
            </details>
          ) : (
            <a href="/auth/discord">Log in</a>
          )}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap site-footer muted small">
      <a href="/privacy">Privacy</a>
      <a href="/terms">Terms</a>
      <a href="https://github.com/Ringpro/wow-forever-party-planner">Source code</a>
    </footer>
    {user && (
      <nav class="tab-bar" aria-label="Main">
        <a href="/app" aria-current={current("overview")}>Tonight</a>
        <a href="/app/schedule" aria-current={current("schedule")}>My schedule</a>
        <a href="/app/characters" aria-current={current("characters")}>Characters</a>
      </nav>
    )}
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #14161c;
    --surface: #1c1f27;
    --surface-2: #252935;
    --surface-3: #2f3443;
    --text: #ecebe6;
    --muted: #9b98a3;
    --border: #2d313d;
    --accent: #e3b341;
    --accent-ink: #1d1605;
    --link: #f0c96a;
    --yes: #3ba36b;
    --yes-soft: rgba(59, 163, 107, 0.16);
    --maybe: #d9a628;
    --maybe-soft: rgba(217, 166, 40, 0.16);
    --no: #d0574a;
    --no-soft: rgba(208, 87, 74, 0.14);
    --radius: 14px;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }
  @media (prefers-color-scheme: light) {
    :root {
      color-scheme: light;
      --bg: #f5f3ee;
      --surface: #ffffff;
      --surface-2: #f1eee7;
      --surface-3: #e6e2d8;
      --text: #1d1c1a;
      --muted: #6c6860;
      --border: #e3dfd5;
      --accent: #c9921a;
      --accent-ink: #ffffff;
      --link: #94690c;
      --yes: #23854f;
      --yes-soft: rgba(35, 133, 79, 0.12);
      --maybe: #b58312;
      --maybe-soft: rgba(181, 131, 18, 0.14);
      --no: #b8443a;
      --no-soft: rgba(184, 68, 58, 0.1);
      --shadow: 0 1px 2px rgba(40, 30, 10, 0.06);
    }
  }

  * {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  [id] {
    scroll-margin-top: 72px;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.5 Inter, system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 16px;
  }
  main.wrap {
    padding-top: 24px;
    padding-bottom: 48px;
  }
  .site-footer {
    display: flex;
    gap: 20px;
    padding-top: 20px;
    padding-bottom: 32px;
    border-top: 1px solid var(--border);
  }
  .site-footer a {
    color: var(--muted);
  }
  a {
    color: var(--link);
    text-underline-offset: 2px;
  }
  h1 {
    font-size: 1.75rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
  }
  h2 {
    font-size: 1.1rem;
    margin: 32px 0 12px;
  }
  h3 {
    font-size: 1rem;
    margin: 0 0 8px;
  }
  p {
    margin: 0 0 12px;
  }
  .muted {
    color: var(--muted);
  }
  .small {
    font-size: 0.875rem;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: #171a21;
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 60px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
    color: var(--text);
    text-decoration: none;
    font-family: Cinzel, Georgia, serif;
    font-size: 20px;
    letter-spacing: 0.04em;
  }
  .top-nav {
    display: flex;
    align-items: center;
    gap: 22px;
    font-size: 15px;
  }
  .top-nav a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
    padding: 4px 0;
  }
  .top-nav a[aria-current="page"] {
    color: var(--text);
    box-shadow: 0 2px 0 var(--accent);
  }
  .top-nav a:hover {
    color: var(--text);
  }
  .account {
    position: relative;
  }
  .account summary {
    list-style: none;
    cursor: pointer;
  }
  .account summary::-webkit-details-marker {
    display: none;
  }
  .avatar {
    width: 34px;
    height: 34px;
    border-radius: 50%;
    background: #2b4a8a;
    color: #fff;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    font-size: 13px;
    font-weight: 600;
  }
  .account-menu {
    position: absolute;
    right: 0;
    top: 44px;
    min-width: 180px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 14px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--border);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
  }
  .account-menu form {
    margin: 0;
  }
  .tab-bar {
    display: none;
  }
  @media (max-width: 640px) {
    .top-nav > a:not([href="/get"]) {
      display: none;
    }
    .signed-in .top-nav > a[href="/get"] {
      display: none;
    }
    .signed-in .site-footer {
      padding-bottom: 96px;
    }
    .tab-bar {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      position: fixed;
      left: 0;
      right: 0;
      bottom: 0;
      z-index: 10;
      background: #171a21;
      border-top: 1px solid var(--border);
      padding-bottom: env(safe-area-inset-bottom);
    }
    .tab-bar a {
      padding: 14px 0 16px;
      text-align: center;
      font-size: 13px;
      color: var(--muted);
      text-decoration: none;
    }
    .tab-bar a[aria-current="page"] {
      color: var(--accent);
      font-weight: 600;
    }
  }

  /* Page header */
  .page-head {
    margin-bottom: 20px;
  }
  .page-head p {
    margin: 0;
  }

  /* Surfaces */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 16px;
    box-shadow: var(--shadow);
  }
  .card > h2:first-child,
  .card > h3:first-child {
    margin-top: 0;
  }
  .card > .button {
    margin: 4px 0 16px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .stack > * {
    margin: 0;
  }

  /* Buttons and inputs */
  button {
    font: inherit;
    cursor: pointer;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid transparent;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 650;
    text-decoration: none;
  }
  .button.secondary {
    background: var(--surface-2);
    color: var(--text);
    border-color: var(--border);
  }
  .button.danger {
    background: transparent;
    color: var(--no);
    border-color: var(--no);
  }
  .button.discord {
    background: #5865f2;
    color: #fff;
  }
  .button[aria-disabled="true"] {
    opacity: 0.5;
    pointer-events: none;
  }
  button.link {
    background: none;
    border: 0;
    padding: 0;
    color: var(--link);
  }
  button.link.muted {
    color: var(--muted);
  }
  input,
  select {
    font: inherit;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    min-height: 44px;
    padding: 8px 12px;
    max-width: 100%;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: 500;
  }
  label.check {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    font-weight: 400;
  }
  label.check input {
    min-height: 0;
    width: 20px;
    height: 20px;
    accent-color: var(--accent);
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Messages */
  .error,
  .notice {
    padding: 10px 14px;
    border-radius: 10px;
    margin-bottom: 16px;
  }
  .error {
    background: var(--no-soft);
    border: 1px solid var(--no);
  }
  .notice {
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  /* Status chips (read-only) */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 0.875rem;
    background: var(--surface-2);
    color: var(--muted);
    white-space: nowrap;
  }
  .chip.yes {
    background: var(--yes-soft);
    color: var(--yes);
  }
  .chip.maybe {
    background: var(--maybe-soft);
    color: var(--maybe);
  }
  .chip.no {
    background: var(--no-soft);
    color: var(--no);
  }
  .chip.default {
    outline: 1px dashed currentColor;
    outline-offset: -1px;
  }

  /* Class colour dot next to a character or player name */
  .class-dot {
    display: inline-block;
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--c, var(--muted));
    flex: none;
  }

  /* Date column used by schedule and group rows */
  .day-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
  }
  .dow {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .dom {
    font-size: 1.4rem;
    font-weight: 700;
  }
  .badge {
    margin-top: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-ink);
    background: var(--accent);
    border-radius: 6px;
    padding: 1px 6px;
  }

  /* Week section heading */
  .week-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 28px 0 10px;
  }
  .week-head h2 {
    margin: 0;
  }

  /* Tabs */
  .tabs {
    display: inline-flex;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 3px;
    gap: 2px;
    margin-bottom: 16px;
  }
  .tabs a {
    padding: 8px 14px;
    border-radius: 9px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .tabs a[aria-current="page"] {
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }

  /* Lists */
  ul.plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .list-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--border);
  }
  .list-row:first-child {
    border-top: 0;
  }

  input.invite {
    width: 100%;
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
  }
</style>
