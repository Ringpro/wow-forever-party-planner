---
interface Props {
  title: string;
  active?: "schedule" | "tools";
}
const { title, active } = Astro.props;
const user = Astro.locals.user;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#14161c" />
    <title>{title} · Muster</title>
    <link rel="icon" href="/muster.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap header-inner">
        <a href={user ? "/app" : "/"} class="brand">
          <img src="/muster.svg" width="28" height="28" alt="" />
          Muster
        </a>
        <nav>
          {user && <a href="/app" aria-current={active === "schedule" ? "page" : undefined}>Schedule</a>}
          <a href="/get" aria-current={active === "tools" ? "page" : undefined}>Tools</a>
          {user ? (
            <form method="post" action="/auth/logout">
              <button class="link muted" type="submit">Log out</button>
            </form>
          ) : (
            <a href="/auth/discord">Log in</a>
          )}
        </nav>
      </div>
    </header>
    <main class="wrap">
      <slot />
    </main>
  </body>
</html>

<style is:global>
  :root {
    color-scheme: dark;
    --bg: #14161c;
    --surface: #1c1f27;
    --surface-2: #252935;
    --surface-3: #2f3443;
    --text: #ecebe6;
    --muted: #9b98a3;
    --border: #2d313d;
    --accent: #e3b341;
    --accent-ink: #1d1605;
    --link: #f0c96a;
    --yes: #3ba36b;
    --yes-soft: rgba(59, 163, 107, 0.16);
    --maybe: #d9a628;
    --maybe-soft: rgba(217, 166, 40, 0.16);
    --no: #d0574a;
    --no-soft: rgba(208, 87, 74, 0.14);
    --radius: 14px;
    --shadow: 0 1px 2px rgba(0, 0, 0, 0.25);
  }
  @media (prefers-color-scheme: light) {
    :root {
      color-scheme: light;
      --bg: #f5f3ee;
      --surface: #ffffff;
      --surface-2: #f1eee7;
      --surface-3: #e6e2d8;
      --text: #1d1c1a;
      --muted: #6c6860;
      --border: #e3dfd5;
      --accent: #c9921a;
      --accent-ink: #ffffff;
      --link: #94690c;
      --yes: #23854f;
      --yes-soft: rgba(35, 133, 79, 0.12);
      --maybe: #b58312;
      --maybe-soft: rgba(181, 131, 18, 0.14);
      --no: #b8443a;
      --no-soft: rgba(184, 68, 58, 0.1);
      --shadow: 0 1px 2px rgba(40, 30, 10, 0.06);
    }
  }

  * {
    box-sizing: border-box;
  }
  html {
    -webkit-text-size-adjust: 100%;
  }
  [id] {
    scroll-margin-top: 72px;
  }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--text);
    font: 16px/1.5 system-ui, -apple-system, "Segoe UI", Roboto, sans-serif;
  }
  .wrap {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 16px;
  }
  main.wrap {
    padding-top: 24px;
    padding-bottom: 64px;
  }
  a {
    color: var(--link);
    text-underline-offset: 2px;
  }
  h1 {
    font-size: 1.75rem;
    line-height: 1.2;
    letter-spacing: -0.01em;
    margin: 0 0 6px;
  }
  h2 {
    font-size: 1.1rem;
    margin: 32px 0 12px;
  }
  h3 {
    font-size: 1rem;
    margin: 0 0 8px;
  }
  p {
    margin: 0 0 12px;
  }
  .muted {
    color: var(--muted);
  }
  .small {
    font-size: 0.875rem;
  }

  /* Header */
  .site-header {
    position: sticky;
    top: 0;
    z-index: 10;
    background: color-mix(in srgb, var(--bg) 88%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
  }
  .header-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: 56px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
    color: var(--text);
    text-decoration: none;
  }
  nav {
    display: flex;
    align-items: center;
    gap: 18px;
  }
  nav a {
    color: var(--muted);
    text-decoration: none;
    font-weight: 500;
  }
  nav a[aria-current="page"],
  nav a:hover {
    color: var(--text);
  }
  nav form {
    margin: 0;
  }

  /* Page header */
  .page-head {
    margin-bottom: 20px;
  }
  .page-head p {
    margin: 0;
  }

  /* Surfaces */
  .card {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 16px;
    margin-bottom: 16px;
    box-shadow: var(--shadow);
  }
  .card > h2:first-child,
  .card > h3:first-child {
    margin-top: 0;
  }
  .card > .button {
    margin: 4px 0 16px;
  }
  .stack {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .stack > * {
    margin: 0;
  }

  /* Buttons and inputs */
  button {
    font: inherit;
    cursor: pointer;
  }
  .button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 10px 18px;
    border-radius: 10px;
    border: 1px solid transparent;
    background: var(--accent);
    color: var(--accent-ink);
    font-weight: 650;
    text-decoration: none;
  }
  .button.secondary {
    background: var(--surface-2);
    color: var(--text);
    border-color: var(--border);
  }
  .button.danger {
    background: transparent;
    color: var(--no);
    border-color: var(--no);
  }
  .button.discord {
    background: #5865f2;
    color: #fff;
  }
  .button[aria-disabled="true"] {
    opacity: 0.5;
    pointer-events: none;
  }
  button.link {
    background: none;
    border: 0;
    padding: 0;
    color: var(--link);
  }
  button.link.muted {
    color: var(--muted);
  }
  input,
  select {
    font: inherit;
    color: var(--text);
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    min-height: 44px;
    padding: 8px 12px;
    max-width: 100%;
  }
  label {
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-weight: 500;
  }
  label.check {
    flex-direction: row;
    align-items: center;
    gap: 10px;
    font-weight: 400;
  }
  label.check input {
    min-height: 0;
    width: 20px;
    height: 20px;
    accent-color: var(--accent);
  }
  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }

  /* Messages */
  .error,
  .notice {
    padding: 10px 14px;
    border-radius: 10px;
    margin-bottom: 16px;
  }
  .error {
    background: var(--no-soft);
    border: 1px solid var(--no);
  }
  .notice {
    background: var(--surface-2);
    border: 1px solid var(--border);
  }

  /* Status chips (read-only) */
  .chip {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 10px;
    border-radius: 999px;
    font-size: 0.875rem;
    background: var(--surface-2);
    color: var(--muted);
    white-space: nowrap;
  }
  .chip.yes {
    background: var(--yes-soft);
    color: var(--yes);
  }
  .chip.maybe {
    background: var(--maybe-soft);
    color: var(--maybe);
  }
  .chip.no {
    background: var(--no-soft);
    color: var(--no);
  }
  .chip.default {
    outline: 1px dashed currentColor;
    outline-offset: -1px;
  }

  /* Date column used by schedule and group rows */
  .day-date {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    line-height: 1.15;
  }
  .dow {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--muted);
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
  .dom {
    font-size: 1.4rem;
    font-weight: 700;
  }
  .badge {
    margin-top: 4px;
    font-size: 0.7rem;
    font-weight: 700;
    color: var(--accent-ink);
    background: var(--accent);
    border-radius: 6px;
    padding: 1px 6px;
  }

  /* Week section heading */
  .week-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 12px;
    margin: 28px 0 10px;
  }
  .week-head h2 {
    margin: 0;
  }

  /* Tabs */
  .tabs {
    display: inline-flex;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: 3px;
    gap: 2px;
    margin-bottom: 16px;
  }
  .tabs a {
    padding: 8px 14px;
    border-radius: 9px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 0.95rem;
  }
  .tabs a[aria-current="page"] {
    background: var(--surface);
    color: var(--text);
    box-shadow: var(--shadow);
  }

  /* Lists */
  ul.plain {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .list-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 12px 0;
    border-top: 1px solid var(--border);
  }
  .list-row:first-child {
    border-top: 0;
  }

  input.invite {
    width: 100%;
    font-family: ui-monospace, monospace;
    font-size: 0.85rem;
  }
</style>
