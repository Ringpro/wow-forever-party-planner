---
// One editable day (or weekday default): No, or up to four Yes/Maybe time slots.
// Each slot is a small form, so it works without JavaScript; scripts/rows.ts upgrades the row to
// save in the background.
import { DEFAULT_START, TIME_OPTIONS, timeOptionsWith } from "../lib/format.ts";

type Slot = { status: "yes" | "maybe"; start: string | null; end: string | null };

interface Props {
  id: string;
  /** Short label on top, e.g. "Wed" or "Mon". */
  title: string;
  /** Large label below, e.g. "28". Optional. */
  subtitle?: string;
  badge?: string;
  hidden: Record<string, string | number>;
  /** The day as a whole. */
  status: "yes" | "maybe" | "no" | "unknown";
  kind: "explicit" | "default" | "unknown";
  slots: Slot[];
  note?: string;
}

const { id, title, subtitle, badge, hidden, status, kind, slots, note } = Astro.props;
const MAX_SLOTS = 4;
// A day with no slots still shows one line: Yes/Maybe/No plus a start time to use.
const lines: (Slot | null)[] = slots.length > 0 ? slots : [null];
---

<div class="day-row" id={id} data-row data-status={status} data-kind={kind}>
  <div class="day-date">
    <span class="dow">{title}</span>
    {subtitle && <span class="dom">{subtitle}</span>}
    {badge && <span class="badge">{badge}</span>}
  </div>
  <div class="day-main">
    {lines.map((slot, i) => (
      <form method="post" class="slot" data-slot data-status={slot?.status ?? (i === 0 ? status : "unknown")}>
        {Object.entries(hidden).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
        <input type="hidden" name="slot" value={i} />
        <div class="seg" role="group" aria-label={`Availability ${title} ${subtitle ?? ""}`}>
          <button class="seg-btn yes" name="status" value="yes" aria-pressed={slot?.status === "yes" ? "true" : "false"}>Yes</button>
          <button class="seg-btn maybe" name="status" value="maybe" aria-pressed={slot?.status === "maybe" ? "true" : "false"}>Maybe</button>
          {i === 0 && (
            <button class="seg-btn no" name="status" value="no" aria-pressed={status === "no" ? "true" : "false"}>No</button>
          )}
        </div>
        <div class="day-times">
          <select name="start" aria-label="Start time">
            {timeOptionsWith(TIME_OPTIONS, slot?.start).map((t) => (
              <option selected={t === (slot?.start ?? DEFAULT_START)}>{t}</option>
            ))}
          </select>
          <span class="muted" aria-hidden="true">–</span>
          <select name="end" aria-label="End time (optional)">
            <option value="">late</option>
            {timeOptionsWith(TIME_OPTIONS, slot?.end).map((t) => <option selected={t === slot?.end}>{t}</option>)}
          </select>
          {slot && (kind === "explicit" || slots.length > 1) && (
            <button class="clear" name="status" value="remove_slot" title="Remove this time" aria-label="Remove this time">
              ×
            </button>
          )}
        </div>
      </form>
    ))}
    <div class="day-actions">
      {slots.length > 0 && slots.length < MAX_SLOTS && (
        <form method="post">
          {Object.entries(hidden).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
          <button class="link small" name="status" value="add_slot">+ Add another time</button>
        </form>
      )}
      {kind === "explicit" && status === "no" && (
        <form method="post">
          {Object.entries(hidden).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
          <button class="link small" name="status" value="clear">Clear</button>
        </form>
      )}
      {note && <span class="day-note">{note}</span>}
    </div>
  </div>
  <span class="saved" aria-hidden="true">Saved</span>
</div>

<style is:global>
  .day-list {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
    overflow: hidden;
  }
  .day-row {
    position: relative;
    display: grid;
    grid-template-columns: 52px 1fr;
    gap: 12px;
    padding: 14px 16px;
    border-top: 1px solid var(--border);
  }
  .day-row:first-child {
    border-top: 0;
  }
  .day-row.saving {
    opacity: 0.6;
  }
  .day-main {
    display: flex;
    flex-direction: column;
    gap: 8px;
    min-width: 0;
  }
  .slot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 12px;
    margin: 0;
  }
  .seg {
    display: inline-flex;
    background: var(--surface-2);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 3px;
    gap: 3px;
  }
  .seg-btn {
    min-height: 38px;
    min-width: 62px;
    padding: 6px 10px;
    border: 0;
    border-radius: 8px;
    background: transparent;
    color: var(--muted);
    font-weight: 650;
  }
  .seg-btn:hover {
    color: var(--text);
    background: var(--surface-3);
  }
  .seg-btn.yes[aria-pressed="true"] {
    background: var(--yes);
    color: #fff;
  }
  .seg-btn.maybe[aria-pressed="true"] {
    background: var(--maybe);
    color: #1d1605;
  }
  .seg-btn.no[aria-pressed="true"] {
    background: var(--no);
    color: #fff;
  }
  /* A weekly default: shown, but softer than an answer you gave for this day. */
  [data-kind="default"] .seg-btn[aria-pressed="true"] {
    background: transparent;
    outline: 1.5px dashed currentColor;
    outline-offset: -2px;
  }
  [data-kind="default"] .seg-btn.yes[aria-pressed="true"] {
    color: var(--yes);
  }
  [data-kind="default"] .seg-btn.maybe[aria-pressed="true"] {
    color: var(--maybe);
  }
  [data-kind="default"] .seg-btn.no[aria-pressed="true"] {
    color: var(--no);
  }
  .day-times {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .day-times select {
    min-height: 40px;
    padding: 6px 8px;
    font-variant-numeric: tabular-nums;
  }
  .slot[data-status="no"] .day-times select,
  .slot[data-status="unknown"] .day-times select {
    color: var(--muted);
  }
  .slot[data-status="no"] .day-times {
    opacity: 0.45;
  }
  .clear {
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 0;
    background: transparent;
    color: var(--muted);
    font-size: 1.3rem;
    line-height: 1;
  }
  .clear:hover {
    background: var(--surface-3);
    color: var(--text);
  }
  .day-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 16px;
  }
  .day-actions form {
    margin: 0;
  }
  .day-actions:empty {
    display: none;
  }
  .day-note {
    font-size: 0.8rem;
    color: var(--muted);
  }
  .saved {
    position: absolute;
    top: 10px;
    right: 14px;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--yes);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .day-row.just-saved .saved {
    opacity: 1;
  }
</style>
