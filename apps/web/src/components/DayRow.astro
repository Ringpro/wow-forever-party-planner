---
// One day (or weekday default) as a slim row: a status pill you tap to cycle Yes → Maybe → No →
// not set, a chip per time slot (tap to edit), and + for another time. Every control is a small
// form, so it works without JavaScript; scripts/rows.ts saves in the background.
import { nextStatus } from "../lib/server/availability.ts";
import { TIME_OPTIONS, timeOptionsWith } from "../lib/format.ts";

type Slot = { status: "yes" | "maybe"; start: string | null; end: string | null };
type DayStatus = "yes" | "maybe" | "no" | "unknown";

interface Props {
  id: string;
  /** Short label on top, e.g. "WED" or "Mon". */
  title: string;
  /** Large label below, e.g. "28". Optional. */
  subtitle?: string;
  highlight?: boolean;
  hidden: Record<string, string | number>;
  status: DayStatus;
  kind: "explicit" | "default" | "unknown";
  slots: Slot[];
  /** Shown on the pill when the day has no answer, e.g. "Not set". */
  emptyLabel?: string;
}

const { id, title, subtitle, highlight, hidden, status, kind, slots, emptyLabel = "Not set" } = Astro.props;
const MAX_SLOTS = 4;
const LABELS: Record<DayStatus, string> = { yes: "Yes", maybe: "Maybe", no: "No", unknown: emptyLabel };
const next = nextStatus(status);
const playing = status === "yes" || status === "maybe";
const nextLabel = next === "unknown" ? "clear it" : LABELS[next];
---

<div class={`day-row${kind === "default" ? " is-default" : ""}`} id={id} data-row>
  <div class={`day-date${highlight ? " is-today" : ""}`}>
    <span class="dow">{title}</span>
    {subtitle && <span class="dom">{subtitle}</span>}
  </div>

  <form method="post" class="pill-form">
    {Object.entries(hidden).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
    <input type="hidden" name="action" value="status" />
    <button
      class={`pill st-${status}`}
      name="status"
      value={next}
      aria-label={`${title} ${subtitle ?? ""}: ${LABELS[status]}${kind === "default" ? " (weekly default)" : ""}. Tap for ${nextLabel}.`}
    >
      {LABELS[status]}
    </button>
  </form>

  <div class="slots">
    {slots.map((slot, i) => (
      <details class="slot">
        <summary class={`chip chip-${slot.status}`}>
          {slot.status === "maybe" && <span aria-hidden="true">~ </span>}
          {slot.start}–{slot.end ?? "late"}
        </summary>
        <form method="post" class="slot-editor">
          {Object.entries(hidden).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
          <input type="hidden" name="slot" value={i} />
          <fieldset class="seg">
            <legend class="sr-only">Yes or Maybe</legend>
            <label class="seg-opt"><input type="radio" name="status" value="yes" checked={slot.status === "yes"} /> Yes</label>
            <label class="seg-opt"><input type="radio" name="status" value="maybe" checked={slot.status === "maybe"} /> Maybe</label>
          </fieldset>
          <label class="time">
            <span class="sr-only">From</span>
            <select name="start">
              {timeOptionsWith(TIME_OPTIONS, slot.start).map((t) => <option selected={t === slot.start}>{t}</option>)}
            </select>
          </label>
          <span class="muted" aria-hidden="true">–</span>
          <label class="time">
            <span class="sr-only">Until</span>
            <select name="end">
              <option value="">late</option>
              {timeOptionsWith(TIME_OPTIONS, slot.end).map((t) => <option selected={t === slot.end}>{t}</option>)}
            </select>
          </label>
          <button class="button small-btn" name="action" value="slot">Save</button>
          <button class="link small" name="action" value="remove_slot">Remove</button>
        </form>
      </details>
    ))}
    {playing && slots.length < MAX_SLOTS && (
      <form method="post" class="add-form">
        {Object.entries(hidden).map(([name, value]) => <input type="hidden" name={name} value={value} />)}
        <button class="add" name="action" value="add_slot" aria-label={`Add another time on ${title} ${subtitle ?? ""}`}>+</button>
      </form>
    )}
    {!playing && status === "unknown" && (
      <span class="hint muted small">Tap to say when you can play</span>
    )}
  </div>
  <span class="saved" aria-hidden="true">Saved</span>
</div>

<style is:global>
  .day-list {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    box-shadow: var(--shadow);
  }
  .day-row {
    position: relative;
    display: grid;
    grid-template-columns: 44px auto 1fr;
    align-items: center;
    gap: 12px;
    padding: 10px 14px;
    border-top: 1px solid var(--border);
  }
  .day-row:first-child {
    border-top: 0;
  }
  .day-row.saving {
    opacity: 0.6;
  }
  .day-date.is-today .dow {
    color: var(--accent);
  }
  .day-date .dom {
    font-size: 1.25rem;
  }
  .pill-form,
  .add-form {
    margin: 0;
  }
  .pill {
    min-width: 78px;
    min-height: 38px;
    padding: 0 12px;
    border-radius: 999px;
    border: 0;
    font-weight: 650;
    font-size: 14px;
  }
  .st-yes {
    background: var(--yes);
    color: #fff;
  }
  .st-maybe {
    background: var(--maybe);
    color: #1d1605;
  }
  .st-no {
    background: var(--no-soft);
    color: var(--no);
  }
  .st-unknown {
    background: transparent;
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--surface-3);
  }
  /* From the weekly default: shown, but softer than an answer for this day. */
  .is-default .pill.st-yes,
  .is-default .pill.st-maybe,
  .is-default .pill.st-no {
    background: transparent;
    box-shadow: inset 0 0 0 1.5px currentColor;
  }
  .is-default .pill.st-yes {
    color: #7fd6a4;
  }
  .is-default .pill.st-maybe {
    color: #f0c45a;
  }
  .slots {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-end;
    gap: 6px;
    min-width: 0;
  }
  .slot {
    position: relative;
  }
  .slot summary {
    list-style: none;
    cursor: pointer;
  }
  .slot summary::-webkit-details-marker {
    display: none;
  }
  .chip-yes,
  .chip-maybe {
    display: inline-flex;
    align-items: center;
    min-height: 34px;
    padding: 0 10px;
    border-radius: 8px;
    background: var(--surface-2);
    color: var(--text);
    font-size: 13px;
    font-variant-numeric: tabular-nums;
  }
  .chip-maybe {
    box-shadow: inset 0 -2px 0 var(--maybe);
  }
  .slot[open] summary {
    background: var(--surface-3);
  }
  .slot-editor {
    position: absolute;
    right: 0;
    top: 42px;
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    width: max-content;
    max-width: min(340px, calc(100vw - 32px));
    padding: 12px;
    border-radius: 12px;
    background: var(--surface);
    border: 1px solid var(--surface-3);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.45);
  }
  .seg {
    display: inline-flex;
    gap: 3px;
    padding: 3px;
    margin: 0;
    border: 1px solid var(--border);
    border-radius: 10px;
    background: var(--surface-2);
  }
  .seg-opt {
    flex-direction: row;
    align-items: center;
    gap: 6px;
    padding: 6px 10px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
  }
  .seg-opt input {
    accent-color: var(--accent);
    margin: 0;
  }
  .time select {
    min-height: 38px;
    padding: 4px 8px;
    font-variant-numeric: tabular-nums;
  }
  .small-btn {
    min-height: 38px;
    padding: 6px 14px;
  }
  .add {
    width: 34px;
    height: 34px;
    border-radius: 8px;
    border: 1px dashed var(--surface-3);
    background: transparent;
    color: var(--muted);
    font-size: 18px;
    line-height: 1;
  }
  .add:hover {
    color: var(--text);
    border-color: var(--muted);
  }
  .hint {
    text-align: right;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  .saved {
    position: absolute;
    top: 4px;
    right: 10px;
    font-size: 0.7rem;
    font-weight: 600;
    color: var(--yes);
    opacity: 0;
    transition: opacity 0.3s;
    pointer-events: none;
  }
  .day-row.just-saved .saved {
    opacity: 1;
  }
  @media (max-width: 420px) {
    .hint {
      display: none;
    }
  }
</style>
