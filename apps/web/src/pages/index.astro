---
import Layout from "../layouts/Layout.astro";

if (Astro.locals.user) return Astro.redirect("/app");
---

<Layout title="Home">
  <h1>Less time planning. More time playing together.</h1>
  <p class="muted">
    Mark which evenings you can play, from here or from Discord, and see when enough of your group overlaps.
  </p>
  <div class="card stack">
    <a class="button" href="/auth/discord">Log in with Discord</a>
    <p class="muted">
      We only ask Discord for your username and ID. No messages, servers or email.
    </p>
  </div>
</Layout>
