---
// Overview: tonight and the next two weeks across all your servers, squads and groups.
import Layout from "../layouts/Layout.astro";
import { HOUR, addDays } from "@muster/domain";
import { dayLabel, timeIn } from "../lib/format.ts";
import {
  groupWeek,
  myDays,
  planningDays,
  planningWeeks,
  setFreeNow,
  shiftToday,
  type GroupWeek,
} from "../lib/server/availability.ts";
import { refreshBoardsLater } from "../lib/server/background.ts";
import { CLASS_COLORS } from "../lib/server/characters.ts";
import { getDb } from "../lib/server/db.ts";
import { listMyGroups, setSharing } from "../lib/server/groups.ts";
import { UserError } from "../lib/server/users.ts";

const user = Astro.locals.user!;
const tz = user.timezone!;
const db = getDb();
let error: string | null = null;
let notice: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  try {
    if (action === "share") {
      const groupId = String(form.get("group") ?? "");
      await setSharing(db, user.id, groupId, form.get("share") === "yes");
      refreshBoardsLater(Astro.locals, { groupIds: [groupId] });
      return Astro.redirect("/app");
    }
    if (action === "free") {
      await setFreeNow(db, user.id, Date.now() + 2 * HOUR);
      refreshBoardsLater(Astro.locals, { userId: user.id });
      return Astro.redirect("/app?done=free");
    }
    if (action === "late") {
      const shifted = await shiftToday(db, user, 30, "web");
      refreshBoardsLater(Astro.locals, { userId: user.id });
      return Astro.redirect(`/app?done=late&to=${shifted.to}`);
    }
  } catch (e) {
    if (!(e instanceof UserError)) throw e;
    error = e.message;
  }
}

const done = Astro.url.searchParams.get("done");
if (done === "free") notice = "You're marked as free for the next 2 hours.";
if (done === "late") notice = `Moved today's start to ${Astro.url.searchParams.get("to")}.`;

const days = planningDays(tz);
const today = days[0]!;
const groups = await listMyGroups(db, user.id);
const undecided = groups.filter((g) => g.kind === "server" && g.shareDecidedAt === null);
const weeks = (await Promise.all(groups.map((g) => groupWeek(db, user, g.id, days)))).filter(
  (w): w is GroupWeek => w !== null,
);
const mine = await myDays(db, user.id, days);
// The grid shows one calendar week at a time, Monday to Sunday, so it always fits the screen.
// Days before today are greyed out.
const calendarWeeks = planningWeeks(tz).map((w) => ({
  key: w.key,
  cols: Array.from({ length: 7 }, (_, i) => addDays(w.monday, i)),
  range: `${dayLabel(w.monday).slice(4)} – ${dayLabel(addDays(w.monday, 6)).slice(4)}`,
}));
const groupDay = new Map(weeks.map((w) => [w.group.id, new Map(w.days.map((gd) => [gd.day, gd]))]));
const kindOf = new Map(groups.map((g) => [g.id, g.kind]));

const freeNow = [
  ...new Map(
    weeks.flatMap((w) => w.freeNow.filter((f) => f.userId !== user.id).map((f) => [f.userId, { ...f, group: w.group.name }])),
  ).values(),
];

const hour = Number(timeIn(Date.now(), tz).slice(0, 2));
const greeting = hour < 5 || hour >= 18 ? "Evening" : hour < 12 ? "Morning" : "Afternoon";
const firstName = user.displayName.split(/\s+/)[0];
const dow = (d: string) => (d === today ? "Today" : dayLabel(d).slice(0, 3));
const dom = (d: string) => String(Number(d.slice(8)));
const iconLetter = (name: string) => name.slice(0, 1).toUpperCase();
const kindLabel = (w: GroupWeek) =>
  kindOf.get(w.group.id) === "server" ? "Discord server" : kindOf.get(w.group.id) === "squad" ? "Squad" : "Private group";

const tonight = weeks.map((w) => {
  const day = w.days[0]!;
  const playing = day.members.filter((m) => m.status === "yes" || m.status === "maybe");
  return {
    week: w,
    best: day.best,
    summary: day.best
      ? `${day.best.memberIds.length} of ${w.members.length} can play${day.best.includesMaybe ? " if the Maybes come" : ""}`
      : playing.length > 0
        ? `${playing.length} of ${w.members.length} so far, not enough yet`
        : "Nobody has answered yet",
    people: playing.map((m) => ({
      name: m.displayName,
      time: m.slots[0] ? timeIn(m.slots[0].startsAt, tz) : "",
      maybe: m.status === "maybe",
      color: w.characters.get(m.userId) ? CLASS_COLORS[w.characters.get(m.userId)!.class] : "var(--muted)",
    })),
  };
});
---

<Layout title="Overview" active="overview">
  <div class="overview-head">
    <div>
      <div class="muted small strong">{dayLabel(today)} · {tz.replaceAll("_", " ")}</div>
      <h1>{greeting}, {firstName}</h1>
    </div>
    <div class="quick">
      <form method="post"><input type="hidden" name="action" value="free" /><button class="button go">I'm free now</button></form>
      <form method="post"><input type="hidden" name="action" value="late" /><button class="button secondary">Running late</button></form>
      <a class="button" href="/app/schedule">Plan my week</a>
    </div>
  </div>

  <div id="flash">
    {error && <p class="error" role="alert">{error}</p>}
    {notice && <p class="notice">{notice}</p>}
  </div>

  {undecided.map((g) => (
    <form method="post" class="card share-ask">
      <input type="hidden" name="action" value="share" />
      <input type="hidden" name="group" value={g.id} />
      {g.iconUrl ? <img class="g-icon" src={g.iconUrl} width="36" height="36" alt="" /> : <span class="g-icon letter">{iconLetter(g.name)}</span>}
      <div class="share-ask-text">
        <strong>Share your schedule with {g.name}?</strong>
        <span class="muted small">You're in this Discord server, and it uses Muster.</span>
      </div>
      <div class="share-ask-buttons">
        <button class="button" name="share" value="yes">Share</button>
        <button class="button secondary" name="share" value="no">Not now</button>
      </div>
    </form>
  ))}

  {freeNow.length > 0 && (
    <div class="free-strip">
      <span class="pulse" aria-hidden="true"></span>
      <span>
        {freeNow.map((f, i) => (
          <>
            {i > 0 && ", "}
            <strong>{f.displayName}</strong> until {timeIn(f.until, tz)}
          </>
        ))}
        {" "}{freeNow.length === 1 ? "is" : "are"} free right now
      </span>
    </div>
  )}

  {weeks.length === 0 ? (
    <div class="card empty">
      <h2>Gather your party</h2>
      <p class="muted">
        Muster finds your Discord servers when you log in. <a href="/get">Add Muster to your server</a>, then log in again.
        Not on Discord together? <a href="/groups/new">Create a private group</a>.
      </p>
    </div>
  ) : (
    <>
      <section>
        <h2>Tonight</h2>
        <div class="tonight">
          {tonight.map((t) => (
            <a class="card tonight-card" href={`/groups/${t.week.group.id}`}>
              <div class="t-head">
                {t.week.group.iconUrl ? (
                  <img class="g-icon" src={t.week.group.iconUrl} width="34" height="34" alt="" />
                ) : (
                  <span class="g-icon letter">{iconLetter(t.week.group.name)}</span>
                )}
                <span class="t-name">
                  <strong>{t.week.group.name}</strong>
                  <span class="muted small">{kindLabel(t.week)}</span>
                </span>
              </div>
              <div class="t-time">
                <span class={`big ${t.best ? (t.best.includesMaybe ? "possible" : "enough") : "none"}`}>
                  {t.best ? timeIn(t.best.startsAt, tz) : "–"}
                </span>
                <span class="t-summary">{t.summary}</span>
              </div>
              {t.people.length > 0 && (
                <div class="people">
                  {t.people.map((p) => (
                    <span class={`person${p.maybe ? " maybe" : ""}`}>
                      <span class="class-dot" style={`--c:${p.color}`}></span>
                      {p.name} {p.time}
                    </span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      </section>

      <section class="weeks">
        <div class="section-head">
          <h2>Your groups</h2>
          <div class="seg" role="radiogroup" aria-label="Week">
            {calendarWeeks.map((cw, i) => (
              <label>
                <input type="radio" name="week" value={cw.key} checked={i === 0} />
                <span>{cw.key === "this" ? "This week" : "Next week"}</span>
              </label>
            ))}
          </div>
        </div>
        {calendarWeeks.map((cw) => (
          <div class={`grid-box week-${cw.key}`}>
            <div class="grid">
              <span class="corner muted small">{cw.range}</span>
              {cw.cols.map((d) => (
                <span class={`col-head${d === today ? " is-today" : ""}${d < today ? " is-past" : ""}`}>
                  <strong>{dow(d)}</strong>
                  <span>{dom(d)}</span>
                </span>
              ))}

              <span class="row-name">
                <span class="g-icon letter small me">{iconLetter(user.displayName)}</span>
                <span>You<span class="muted tiny">Your answers</span></span>
              </span>
              {cw.cols.map((d) => {
                const a = mine.get(d);
                if (!a) return <span class="cell past" aria-hidden="true"></span>;
                const status = a.kind === "unknown" ? "unknown" : a.status;
                const first = a.kind === "unknown" ? null : a.slots[0];
                const more = a.kind === "unknown" ? 0 : a.slots.length - 1;
                return (
                  <a
                    href={`/app/schedule#d-${d}`}
                    class={`cell me-${status}${a.kind === "default" ? " me-default" : ""}${d === today ? " is-today" : ""}`}
                    title={`${dayLabel(d)}: ${status === "unknown" ? "not set" : status}`}
                  >
                    <span class="t">{status === "no" ? "No" : first?.startLocal ?? "?"}</span>
                    <span class="sub">{more > 0 ? `+${more}` : status === "maybe" ? "Maybe" : ""}</span>
                  </a>
                );
              })}

              {weeks.map((w) => (
                <>
                  <a class={`row-name${kindOf.get(w.group.id) === "squad" ? " squad" : ""}`} href={`/groups/${w.group.id}`}>
                    {w.group.iconUrl ? (
                      <img class="g-icon small" src={w.group.iconUrl} width="22" height="22" alt="" />
                    ) : (
                      <span class="g-icon letter small">{iconLetter(w.group.name)}</span>
                    )}
                    <span>
                      {w.group.name}
                      <span class="muted tiny">
                        {w.members.length} {w.members.length === 1 ? "member" : "members"}
                      </span>
                    </span>
                  </a>
                  {cw.cols.map((d) => {
                    const gd = groupDay.get(w.group.id)?.get(d);
                    if (!gd) return <span class="cell past" aria-hidden="true"></span>;
                    return (
                      <a
                        href={`/groups/${w.group.id}${cw.key === "next" ? "?week=next" : ""}`}
                        class={`cell ${gd.best ? (gd.best.includesMaybe ? "possible" : "enough") : "none"}${d === today ? " is-today" : ""}`}
                        title={`${w.group.name}, ${dayLabel(d)}`}
                      >
                        <span class="t">{gd.best ? timeIn(gd.best.startsAt, tz) : "–"}</span>
                        <span class="sub">{gd.best ? `${gd.best.memberIds.length}/${w.members.length}` : ""}</span>
                      </a>
                    );
                  })}
                </>
              ))}
            </div>
          </div>
        ))}
        <div class="legend muted small">
          <span><span class="class-dot" style="--c:var(--yes)"></span> Enough players</span>
          <span><span class="class-dot" style="--c:var(--maybe)"></span> If the Maybes come</span>
          <span>Dashed = your weekly default</span>
        </div>
        <p class="muted small">Each cell is the earliest time enough people overlap. Open a group for who and when.</p>
      </section>
    </>
  )}
</Layout>

<style>
  .overview-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .overview-head h1 {
    font-size: 30px;
    margin: 4px 0 0;
  }
  .strong {
    font-weight: 500;
  }
  .quick {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
  .quick form {
    margin: 0;
  }
  .button.go {
    background: var(--yes);
    color: #fff;
  }
  @media (max-width: 640px) {
    .quick {
      display: grid;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 8px;
      width: 100%;
    }
    .quick form,
    .quick .button {
      width: 100%;
    }
    .quick .button {
      padding: 6px 8px;
      font-size: 13px;
      text-align: center;
      line-height: 1.2;
    }
  }
  .share-ask {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 12px;
  }
  .share-ask-text {
    display: flex;
    flex-direction: column;
    flex: 1 1 220px;
  }
  .share-ask-buttons {
    display: flex;
    gap: 8px;
  }
  .g-icon {
    width: 34px;
    height: 34px;
    border-radius: 10px;
    flex: none;
    object-fit: cover;
  }
  .g-icon.letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #a8322d;
    color: #fff;
    font-weight: 700;
  }
  .g-icon.small {
    width: 22px;
    height: 22px;
    border-radius: 6px;
    font-size: 11px;
  }
  .g-icon.me {
    background: #2b4a8a;
  }
  .free-strip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--yes-soft);
    border: 1px solid rgba(59, 163, 107, 0.35);
    margin-bottom: 8px;
  }
  .pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--yes);
    box-shadow: 0 0 0 4px rgba(59, 163, 107, 0.25);
    flex: none;
  }
  .empty h2 {
    margin-top: 0;
  }
  .tonight {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 14px;
  }
  .tonight-card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin: 0;
    color: var(--text);
    text-decoration: none;
  }
  .tonight-card:hover {
    border-color: var(--surface-3);
  }
  .t-head {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .t-name {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
  }
  .t-time {
    display: flex;
    align-items: baseline;
    gap: 10px;
    flex-wrap: wrap;
  }
  .big {
    font-size: 34px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .big.enough {
    color: #7fd6a4;
  }
  .big.possible {
    color: #f0c45a;
  }
  .big.none {
    color: var(--muted);
  }
  .t-summary {
    color: #c9c6cf;
  }
  .people {
    display: flex;
    gap: 6px;
    flex-wrap: wrap;
  }
  .person {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 3px 9px;
    border-radius: 999px;
    background: var(--surface-2);
    font-size: 13px;
    color: #9be3b9;
  }
  .person.maybe {
    color: #f5cf6e;
  }
  .person .class-dot {
    width: 8px;
    height: 8px;
  }
  .section-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
    flex-wrap: wrap;
  }
  .legend {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    margin: 10px 0 4px;
  }
  .section-head h2,
  .section-head .seg {
    margin: 32px 0 12px;
  }
  /* This week / Next week toggle without JavaScript: the checked radio picks which grid shows. */
  .seg {
    display: inline-flex;
    padding: 3px;
    border-radius: 10px;
    background: var(--surface-2);
    border: 1px solid var(--border);
  }
  .seg label {
    position: relative;
  }
  .seg input {
    position: absolute;
    opacity: 0;
    inset: 0;
    margin: 0;
    cursor: pointer;
  }
  .seg span {
    display: block;
    padding: 6px 14px;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--muted);
  }
  .seg input:checked + span {
    background: var(--surface-3);
    color: var(--text);
  }
  .seg input:focus-visible + span {
    outline: 2px solid var(--accent);
  }
  .weeks:has(input[value="this"]:checked) .week-next,
  .weeks:has(input[value="next"]:checked) .week-this {
    display: none;
  }
  .grid-box {
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .grid {
    display: grid;
    grid-template-columns: 180px repeat(7, minmax(0, 1fr));
    gap: 6px;
    padding: 14px;
    align-items: center;
  }
  .corner {
    align-self: end;
    padding-bottom: 2px;
  }
  @media (max-width: 640px) {
    /* Phones: the name sits on its own line above its row, so all seven days fit across. */
    .grid {
      grid-template-columns: repeat(7, minmax(0, 1fr));
      gap: 4px;
      padding: 10px;
    }
    .corner {
      display: none;
    }
    .grid .row-name {
      grid-column: 1 / -1;
      margin-top: 8px;
      font-size: 13px;
    }
    .grid .row-name .g-icon {
      width: 18px;
      height: 18px;
      font-size: 10px;
    }
    .grid .row-name > span:last-child {
      flex-direction: row;
      gap: 8px;
      align-items: baseline;
    }
    .grid .row-name.squad {
      padding-left: 0;
    }
    .grid .cell {
      height: 44px;
    }
    .grid .cell .t {
      font-size: 12px;
    }
    .grid .cell .sub {
      font-size: 10px;
    }
    .legend {
      gap: 4px 14px;
    }
  }
  .col-head {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: 12px;
    color: var(--muted);
    line-height: 1.3;
  }
  .col-head.is-today {
    color: var(--accent);
  }
  .col-head.is-past {
    opacity: 0.4;
  }
  .cell.past {
    background: repeating-linear-gradient(135deg, transparent 0 6px, rgba(255, 255, 255, 0.025) 6px 12px);
  }
  .row-name {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
    text-decoration: none;
  }
  .row-name > span:last-child {
    display: flex;
    flex-direction: column;
    line-height: 1.2;
  }
  .row-name.squad {
    padding-left: 18px;
  }
  .tiny {
    font-size: 11px;
    font-weight: 500;
  }
  .cell {
    height: 52px;
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 1px;
    font-size: 12px;
    line-height: 1.2;
    text-decoration: none;
  }
  .cell .t {
    font-weight: 700;
    font-size: 14px;
    font-variant-numeric: tabular-nums;
  }
  .cell.is-today {
    box-shadow: inset 0 0 0 2px var(--accent);
  }
  .enough {
    background: rgba(59, 163, 107, 0.18);
    color: #7fd6a4;
  }
  .possible {
    background: rgba(217, 166, 40, 0.16);
    color: #f0c45a;
  }
  .none {
    background: #1f222b;
    color: #6f6c78;
  }
  .me-yes {
    background: rgba(59, 163, 107, 0.22);
    color: #9be3b9;
  }
  .me-maybe {
    background: rgba(217, 166, 40, 0.2);
    color: #f5cf6e;
  }
  .me-no {
    background: rgba(208, 87, 74, 0.16);
    color: #ef8f84;
  }
  .me-unknown {
    color: #6f6c78;
    box-shadow: inset 0 0 0 1px #2d313d;
  }
  .me-default {
    outline: 1px dashed currentColor;
    outline-offset: -3px;
  }
</style>
