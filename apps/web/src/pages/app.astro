---
import DayRow from "../components/DayRow.astro";
import Layout from "../layouts/Layout.astro";
import { dayLabel } from "../lib/format.ts";
import { clearAvailability, copyWeekForward, myDays, planningWeeks, setAvailability } from "../lib/server/availability.ts";
import { refreshBoardsLater } from "../lib/server/background.ts";
import { getDb } from "../lib/server/db.ts";
import { listMyGroups } from "../lib/server/groups.ts";
import { UserError } from "../lib/server/users.ts";
import { addDays } from "@muster/domain";

const user = Astro.locals.user!;
const tz = user.timezone!;
const db = getDb();
let error: string | null = null;
const copied = Astro.url.searchParams.get("copied");
const notice =
  copied === null
    ? null
    : copied === "0"
      ? "Nothing to copy: next week already has answers for those days, or this week is empty."
      : `Copied ${copied} ${copied === "1" ? "day" : "days"} to next week.`;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const day = String(form.get("day") ?? "");
  const status = String(form.get("status") ?? "");
  try {
    if (status === "copy_week") {
      const count = await copyWeekForward(db, user);
      refreshBoardsLater(Astro.locals, { userId: user.id });
      return Astro.redirect(`/app?copied=${count}#week-next`);
    }
    if (status === "clear") {
      await clearAvailability(db, user.id, day);
    } else {
      await setAvailability(
        db,
        user,
        {
          day,
          status,
          startLocal: String(form.get("start") ?? "") || null,
          endLocal: String(form.get("end") ?? "") || null,
        },
        "web",
      );
    }
    refreshBoardsLater(Astro.locals, { userId: user.id });
    return Astro.redirect(`/app#d-${day}`);
  } catch (e) {
    if (!(e instanceof UserError)) throw e;
    error = e.message;
  }
}

const weeks = planningWeeks(tz);
const today = weeks[0]!.days[0]!;
const answers = await myDays(db, user.id, weeks.flatMap((w) => w.days));
const groups = await listMyGroups(db, user.id);
const range = (monday: string) => `${dayLabel(monday).slice(4)} – ${dayLabel(addDays(monday, 6)).slice(4)}`;
const dow = (day: string) => dayLabel(day).slice(0, 3);
const dom = (day: string) => String(Number(day.slice(8)));
---

<Layout title="Schedule" active="schedule">
  <div class="page-head">
    <h1>When can you play?</h1>
    <p class="muted small">
      Times in {tz.replaceAll("_", " ")} (<a href="/onboarding?return_to=/app">change</a>). Days you leave empty use your{" "}
      <a href="/app/defaults">weekly defaults</a>.
    </p>
  </div>

  <div id="flash">
    {error && <p class="error" role="alert">{error}</p>}
    {notice && <p class="notice">{notice}</p>}
  </div>

  {weeks.map((week) => (
    <section id={`week-${week.key}`}>
      <div class="week-head">
        <h2>
          {week.key === "this" ? "This week" : "Next week"} <span class="muted small">{range(week.monday)}</span>
        </h2>
        {week.key === "next" && (
          <form method="post">
            <button class="link small" name="status" value="copy_week">Copy this week</button>
          </form>
        )}
      </div>
      <div class="day-list">
        {week.days.map((day) => {
          const a = answers.get(day)!;
          return (
            <DayRow
              id={`d-${day}`}
              title={dow(day)}
              subtitle={dom(day)}
              badge={day === today ? "Today" : undefined}
              hidden={{ day }}
              status={a.kind === "unknown" ? "unknown" : a.status}
              kind={a.kind}
              start={a.kind === "unknown" ? null : a.startLocal}
              end={a.kind === "unknown" ? null : a.endLocal}
              canClear={a.kind === "explicit"}
              note={a.kind === "default" ? "From your weekly default" : undefined}
            />
          );
        })}
      </div>
    </section>
  ))}

  <section>
    <div class="week-head">
      <h2>Your groups</h2>
      <a class="small" href="/groups/new">New group</a>
    </div>
    <div class="card">
      {groups.length === 0 ? (
        <p class="muted" style="margin:0">
          You're not in a group yet. <a href="/groups/new">Create one</a>, or ask a friend for an invite link.
        </p>
      ) : (
        <ul class="plain">
          {groups.map((g) => (
            <li class="list-row">
              <a href={`/groups/${g.id}`}>{g.name}</a>
              <span class="muted small">{g.role === "admin" ? "Admin" : "Member"}</span>
            </li>
          ))}
        </ul>
      )}
    </div>
  </section>
</Layout>

<script>
  import "../scripts/rows.ts";
</script>
