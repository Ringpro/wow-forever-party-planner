---
import DayRow from "../../components/DayRow.astro";
import Layout from "../../layouts/Layout.astro";
import {
  addDefaultSlot,
  clearWeeklyDefault,
  getWeeklyDefaults,
  removeDefaultSlot,
  setDefaultSlot,
} from "../../lib/server/availability.ts";
import { dayStatus, sortSlots } from "@muster/domain";
import { refreshBoardsLater } from "../../lib/server/background.ts";
import { getDb } from "../../lib/server/db.ts";
import { UserError } from "../../lib/server/users.ts";

const user = Astro.locals.user!;
const db = getDb();
let error: string | null = null;

const WEEKDAYS = [
  [1, "Mon"],
  [2, "Tue"],
  [3, "Wed"],
  [4, "Thu"],
  [5, "Fri"],
  [6, "Sat"],
  [7, "Sun"],
] as const;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const weekday = Number(form.get("weekday"));
  const status = String(form.get("status") ?? "");
  try {
    const slot = Number(form.get("slot") ?? 0);
    if (status === "clear") await clearWeeklyDefault(db, user.id, weekday);
    else if (status === "add_slot") await addDefaultSlot(db, user, weekday);
    else if (status === "remove_slot") await removeDefaultSlot(db, user, weekday, slot);
    else {
      await setDefaultSlot(db, user, weekday, slot, {
        status,
        startLocal: String(form.get("start") ?? "") || null,
        endLocal: String(form.get("end") ?? "") || null,
      });
    }
    refreshBoardsLater(Astro.locals, { userId: user.id });
    return Astro.redirect(`/app/defaults#w-${weekday}`);
  } catch (e) {
    if (!(e instanceof UserError)) throw e;
    error = e.message;
  }
}

const defaults = await getWeeklyDefaults(db, user.id);
---

<Layout title="Weekly defaults" active="schedule">
  <div class="page-head">
    <p class="small"><a href="/app">← Schedule</a></p>
    <h1>Your usual week</h1>
    <p class="muted small">
      Defaults fill in every day you haven't answered, this week and next. Then you only change the exceptions.
    </p>
  </div>

  <div id="flash">{error && <p class="error" role="alert">{error}</p>}</div>

  <div class="day-list">
    {WEEKDAYS.map(([weekday, name]) => {
      const answers = defaults[weekday] ?? [];
      const slots = sortSlots(answers.filter((a) => a.status !== "no"));
      return (
        <DayRow
          id={`w-${weekday}`}
          title={name}
          hidden={{ weekday }}
          status={answers.length > 0 ? dayStatus(answers) : "unknown"}
          kind={answers.length > 0 ? "explicit" : "unknown"}
          slots={slots.map((s) => ({ status: s.status as "yes" | "maybe", start: s.startLocal, end: s.endLocal }))}
        />
      );
    })}
  </div>
</Layout>

<script>
  import "../../scripts/rows.ts";
</script>
