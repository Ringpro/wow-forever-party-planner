---
import DayRow from "../../components/DayRow.astro";
import Layout from "../../layouts/Layout.astro";
import { clearWeeklyDefault, getWeeklyDefaults, setWeeklyDefault } from "../../lib/server/availability.ts";
import { refreshBoardsLater } from "../../lib/server/background.ts";
import { getDb } from "../../lib/server/db.ts";
import { UserError } from "../../lib/server/users.ts";

const user = Astro.locals.user!;
const db = getDb();
let error: string | null = null;

const WEEKDAYS = [
  [1, "Mon"],
  [2, "Tue"],
  [3, "Wed"],
  [4, "Thu"],
  [5, "Fri"],
  [6, "Sat"],
  [7, "Sun"],
] as const;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const weekday = Number(form.get("weekday"));
  const status = String(form.get("status") ?? "");
  try {
    if (status === "clear") {
      await clearWeeklyDefault(db, user.id, weekday);
    } else {
      await setWeeklyDefault(db, user, weekday, {
        status,
        startLocal: String(form.get("start") ?? "") || null,
        endLocal: String(form.get("end") ?? "") || null,
      });
    }
    refreshBoardsLater(Astro.locals, { userId: user.id });
    return Astro.redirect(`/app/defaults#w-${weekday}`);
  } catch (e) {
    if (!(e instanceof UserError)) throw e;
    error = e.message;
  }
}

const defaults = await getWeeklyDefaults(db, user.id);
---

<Layout title="Weekly defaults" active="schedule">
  <div class="page-head">
    <p class="small"><a href="/app">← Schedule</a></p>
    <h1>Your usual week</h1>
    <p class="muted small">
      Defaults fill in every day you haven't answered, this week and next. Then you only change the exceptions.
    </p>
  </div>

  <div id="flash">{error && <p class="error" role="alert">{error}</p>}</div>

  <div class="day-list">
    {WEEKDAYS.map(([weekday, name]) => {
      const d = defaults[weekday];
      return (
        <DayRow
          id={`w-${weekday}`}
          title={name}
          hidden={{ weekday }}
          status={d?.status ?? "unknown"}
          kind={d ? "explicit" : "unknown"}
          start={d?.startLocal ?? null}
          end={d?.endLocal ?? null}
          canClear={Boolean(d)}
        />
      );
    })}
  </div>
</Layout>

<script>
  import "../../scripts/rows.ts";
</script>
