---
import Layout from "../../layouts/Layout.astro";
import { dayLabel, timeIn } from "../../lib/format.ts";
import { groupWeek, planningWeeks } from "../../lib/server/availability.ts";
import { refreshBoardsLater } from "../../lib/server/background.ts";
import { getDb } from "../../lib/server/db.ts";
import {
  CLASS_COLORS,
  CLASS_NAMES,
  REALM_TYPE_NAMES,
  ROLE_NAMES,
  rolesOf,
  type Role,
} from "../../lib/server/characters.ts";
import { guildRoles } from "../../lib/server/discord-sync.ts";
import {
  createSquad,
  deleteSquad,
  getGroupAsMember,
  getInviteToken,
  groupKind,
  leaveGroup,
  listSquads,
  makeAdmin,
  resetInvite,
  setSharing,
  updateGroupSettings,
} from "../../lib/server/groups.ts";
import { UserError } from "../../lib/server/users.ts";

const user = Astro.locals.user!;
const tz = user.timezone!;
const groupId = Astro.params.id ?? "";
const db = getDb();
let error: string | null = null;

if (Astro.request.method === "POST") {
  const form = await Astro.request.formData();
  const action = String(form.get("action") ?? "");
  try {
    if (action === "share") await setSharing(db, user.id, groupId, form.get("share") === "on");
    else if (action === "reset_invite") await resetInvite(db, user.id, groupId);
    else if (action === "make_admin") await makeAdmin(db, user.id, groupId, String(form.get("memberId") ?? ""));
    else if (action === "settings") {
      await updateGroupSettings(db, user.id, groupId, {
        timezone: String(form.get("timezone") ?? ""),
        minPlayers: Number(form.get("minPlayers")),
        gameOnPosts: form.get("gameOnPosts") === "on",
      });
    } else if (action === "create_squad") {
      const squadId = await createSquad(db, user.id, groupId, {
        name: String(form.get("name") ?? ""),
        roleId: String(form.get("roleId") ?? ""),
      });
      return Astro.redirect(`/groups/${squadId}`);
    } else if (action === "delete_squad") {
      const parentId = await deleteSquad(db, user.id, groupId);
      return Astro.redirect(`/groups/${parentId}`);
    } else if (action === "leave") {
      await leaveGroup(db, user.id, groupId);
      refreshBoardsLater(Astro.locals, { groupIds: [groupId] });
      return Astro.redirect("/app");
    }
    refreshBoardsLater(Astro.locals, { groupIds: [groupId] });
    return Astro.redirect(`/groups/${groupId}${Astro.url.search}`);
  } catch (e) {
    if (!(e instanceof UserError)) throw e;
    error = e.message;
  }
}

const weekKey = Astro.url.searchParams.get("week") === "next" ? "next" : "this";
const weeks = planningWeeks(tz);
const selected = weeks.find((w) => w.key === weekKey)!;
const week = await groupWeek(db, user, groupId, selected.days);
if (!week) return new Response("Not found", { status: 404 });
const { group, membership } = week;
const isAdmin = membership.role === "admin";
const kind = groupKind(group);
const parent = group.parentGroupId ? await getGroupAsMember(db, user.id, group.parentGroupId) : null;
const serverId = kind === "server" ? group.id : (parent?.group.id ?? null);
const squads = serverId ? await listSquads(db, serverId) : [];
const inviteUrl =
  isAdmin && kind === "private" ? `${Astro.url.origin}/join/${await getInviteToken(db, user.id, groupId)}` : null;
let roles: { id: string; name: string }[] = [];
if (kind === "server" && isAdmin && group.discordGuildId) {
  roles = await guildRoles(group.discordGuildId).catch(() => []);
}
const roleName = new Map(roles.map((r) => [r.id, r.name]));
const zones = Intl.supportedValuesOf("timeZone");
const today = weeks[0]!.days[0]!;
const time = (instant: number) => timeIn(instant, tz);
const until = (s: { endsAt: number; openEnd: boolean }) => (s.openEnd ? "late" : time(s.endsAt));

// The party: levels, factions, realm types and roles of members' mains.
const mains = week.members.flatMap((m) => {
  const c = week.characters.get(m.userId);
  return c ? [{ ...c, player: m.displayName }] : [];
});
const levels = mains.map((c) => c.level);
const factions = ["horde", "alliance"].flatMap((f) => {
  const n = mains.filter((c) => c.faction === f).length;
  return n > 0 ? [`${n} ${f === "horde" ? "Horde" : "Alliance"}`] : [];
});
const realmTypes = [...new Set(mains.flatMap((c) => (c.realmType ? [REALM_TYPE_NAMES[c.realmType]] : [])))];
const byRole = (role: Role) => mains.filter((c) => rolesOf(c).includes(role)).map((c) => c.player);
const kindLabel = kind === "server" ? "Discord server" : kind === "squad" ? `Squad in ${parent?.group.name ?? "a server"}` : "Private group";
---

<Layout title={group.name}>
  <div class="group-head">
    <div class="group-title">
      {group.iconUrl ? (
        <img class="server-icon" src={group.iconUrl} width="52" height="52" alt="" />
      ) : (
        <span class="server-icon letter" aria-hidden="true">{group.name.slice(0, 1).toUpperCase()}</span>
      )}
      <div>
        <h1>{group.name}</h1>
        <p class="muted small">
          {kindLabel} · {week.members.length} {week.members.length === 1 ? "member" : "members"} ·{" "}
          {`${group.minPlayers} needed`}
        </p>
      </div>
    </div>
    <nav class="tabs" aria-label="Week and squads">
      <a href="?week=this" aria-current={weekKey === "this" ? "page" : undefined}>This week</a>
      <a href="?week=next" aria-current={weekKey === "next" ? "page" : undefined}>Next week</a>
      {serverId && kind === "squad" && <a href={`/groups/${serverId}`}>{parent?.group.name ?? "Server"}</a>}
      {squads
        .filter((s) => s.id !== group.id)
        .map((s) => (
          <a href={`/groups/${s.id}`}>{s.name}</a>
        ))}
    </nav>
  </div>

  <div id="flash">{error && <p class="error" role="alert">{error}</p>}</div>

  {!membership.shareAvailability && (
    <p class="notice">You're not sharing your schedule here, so you show as "no answer". Turn it on under You, below.</p>
  )}

  {week.freeNow.length > 0 && (
    <div class="free-strip">
      <span class="pulse" aria-hidden="true"></span>
      <span>
        <strong>{week.freeNow.map((f) => f.displayName).join(", ")}</strong>{" "}
        {week.freeNow.length === 1 ? "is" : "are"} free right now
        {week.freeNow.length === 1 && ` until ${time(week.freeNow[0]!.until)}`}
      </span>
    </div>
  )}

  <div class="grid-box">
    <div class="grid" style={`grid-template-columns: var(--name-col) repeat(${week.days.length}, minmax(0, 1fr));`}>
      <span></span>
      {week.days.map((d) => (
        <span class={`col-head${d.day === today ? " is-today" : ""}`}>
          <strong>{d.day === today ? "Today" : dayLabel(d.day).slice(0, 3)}</strong> {Number(d.day.slice(8))}
        </span>
      ))}

      <span class="row-label">Best time</span>
      {week.days.map((d) => (
        <span class={`best ${d.best ? (d.best.includesMaybe ? "possible" : "enough") : "none"}`}>
          <span class="best-time">{d.best ? time(d.best.startsAt) : "–"}</span>
          <span class="small">
            {d.best
              ? `${d.best.memberIds.length} ${d.best.includesMaybe ? "with Maybes" : "can play"}`
              : d.counts.yes + d.counts.maybe > 0
                ? "not enough yet"
                : "nobody yet"}
          </span>
        </span>
      ))}

      {week.members.map((m) => {
        const c = week.characters.get(m.userId);
        return (
          <>
            <span class="person">
              <span class="class-dot" style={`--c:${c ? CLASS_COLORS[c.class] : "var(--surface-3)"}`} aria-hidden="true"></span>
              <span class="person-text">
                <strong>{m.displayName}</strong>
                {c && (
                  <span class="muted tiny">
                    {c.name} · {CLASS_NAMES[c.class]} {c.level}
                    {rolesOf(c).length > 0 && ` · ${rolesOf(c).map((r) => ROLE_NAMES[r]).join(", ")}`}
                  </span>
                )}
              </span>
            </span>
            {week.days.map((d) => {
              const md = d.members.find((x) => x.userId === m.userId)!;
              return (
                <span class={`cell${d.day === today ? " is-today" : ""}${md.kind === "default" ? " is-default" : ""}`}>
                  {md.status === "unknown" && <span class="lbl-none">No answer</span>}
                  {md.status === "no" && <span class="lbl-no">Can't play</span>}
                  {md.slots.map((s) => (
                    <span class={`t-${s.status}`} title={`${s.status === "maybe" ? "Maybe" : "Yes"} ${time(s.startsAt)}–${until(s)}`}>
                      <strong>{s.status === "maybe" && "~"}{time(s.startsAt)}</strong>
                      <span class="until">–{until(s)}</span>
                    </span>
                  ))}
                </span>
              );
            })}
          </>
        );
      })}
    </div>
  </div>
  <div class="agenda">
    {week.days.map((d) => {
      const playing = d.members.filter((m) => m.status === "yes" || m.status === "maybe");
      const out = d.members.filter((m) => m.status === "no").map((m) => m.displayName);
      const unknown = d.members.filter((m) => m.status === "unknown").map((m) => m.displayName);
      return (
        <section class={`agenda-day${d.day === today ? " is-today" : ""}`}>
          <div class="agenda-head">
            <strong>{d.day === today ? "Today" : dayLabel(d.day)}</strong>
            <span class={`agenda-best ${d.best ? (d.best.includesMaybe ? "possible" : "enough") : "none"}`}>
              {d.best ? time(d.best.startsAt) : "–"}
            </span>
            <span class="muted small">
              {d.best
                ? `${d.best.memberIds.length} ${d.best.includesMaybe ? "with Maybes" : "can play"}`
                : d.counts.yes + d.counts.maybe > 0
                  ? "not enough yet"
                  : "nobody yet"}
            </span>
          </div>
          {playing.length > 0 && (
            <ul class="agenda-people">
              {playing.map((m) => {
                const c = week.characters.get(m.userId);
                return (
                  <li>
                    <span class="class-dot" style={`--c:${c ? CLASS_COLORS[c.class] : "var(--surface-3)"}`} aria-hidden="true"></span>
                    <span class="agenda-name">{m.displayName}</span>
                    <span class="agenda-times">
                      {m.slots.map((s) => (
                        <span class={`t-${s.status}`}>
                          {s.status === "maybe" && "~"}
                          {time(s.startsAt)}–{until(s)}
                        </span>
                      ))}
                    </span>
                  </li>
                );
              })}
            </ul>
          )}
          {(out.length > 0 || unknown.length > 0) && (
            <p class="muted small agenda-rest">
              {out.length > 0 && <span>Can't play: {out.join(", ")}</span>}
              {unknown.length > 0 && <span>No answer: {unknown.join(", ")}</span>}
            </p>
          )}
        </section>
      );
    })}
  </div>

  <p class="muted small legend">
    <span><span class="class-dot" style="--c:var(--yes)"></span> Yes</span>
    <span><span class="class-dot" style="--c:var(--maybe)"></span> Maybe</span>
    <span>Dashed = from their weekly default</span>
    <span>Times in {tz.replaceAll("_", " ")}</span>
  </p>

  <div class="cards">
    <section class="card">
      <h2>The party</h2>
      {mains.length === 0 ? (
        <p class="muted small">Nobody has added a character yet. <a href="/app/characters">Add yours</a>.</p>
      ) : (
        <>
          <p class="small">
            Levels {Math.min(...levels)}{Math.max(...levels) !== Math.min(...levels) && ` to ${Math.max(...levels)}`}
            {factions.length > 0 && ` · ${factions.join(", ")}`}
            {realmTypes.length > 0 && ` · ${realmTypes.join(", ")}`}
          </p>
          <div class="role-list">
            {(["tank", "healer", "dps"] as const).map((role) => (
              <span class="role-chip">
                <strong>{ROLE_NAMES[role]}:</strong> {byRole(role).join(", ") || "nobody yet"}
              </span>
            ))}
          </div>
        </>
      )}
    </section>

    {serverId && (
      <section class="card">
        <h2>Squads</h2>
        {squads.length === 0 ? (
          <p class="muted small">Smaller groups inside this server, like a raid team. Each follows a Discord role.</p>
        ) : (
          <ul class="plain">
            {squads.map((s) => (
              <li class="list-row">
                <a href={`/groups/${s.id}`}>{s.name}</a>
                {roleName.get(s.roleId ?? "") && <span class="muted small">@{roleName.get(s.roleId ?? "")}</span>}
              </li>
            ))}
          </ul>
        )}
      </section>
    )}

    <section class="card">
      <h2>You</h2>
      <form method="post" class="setting-row">
        <input type="hidden" name="action" value="share" />
        <label class="check">
          <input type="checkbox" name="share" checked={membership.shareAvailability} data-autosubmit />
          Share my schedule here
        </label>
        <noscript><button class="button secondary" type="submit">Save</button></noscript>
      </form>
      <p class="muted small">
        {kind === "server"
          ? "You're in this group because you're in the Discord server."
          : kind === "squad"
            ? "You're in this squad because you have its Discord role."
            : "You joined with an invite link."}
      </p>
    </section>
  </div>

  <details class="card settings">
    <summary><h2>Group settings and members</h2></summary>
    <div class="stack">
      {isAdmin && (
        <form method="post" class="settings-form">
          <input type="hidden" name="action" value="settings" />
          <label>
            Time zone <span class="muted small">(for the Discord board)</span>
            <select name="timezone">
              {zones.map((z) => <option value={z} selected={z === group.timezone}>{z.replaceAll("_", " ")}</option>)}
            </select>
          </label>
          <label>
            Players needed
            <input name="minPlayers" type="number" min="1" max="40" value={group.minPlayers} />
          </label>
          <label class="check game-on">
            <input type="checkbox" name="gameOnPosts" checked={group.gameOnPosts} />
            <span>
              Post "game on" in the board channel when enough people can play
              <span class="muted small block">
                Once a day, not before 10:00. Mentions the people who said Yes. Needs a board (<code>/board setup</code>).
              </span>
            </span>
          </label>
          <button class="button secondary" type="submit">Save</button>
        </form>
      )}

      {kind === "server" && isAdmin && roles.length > 0 && (
        <div>
          <h3>Add a squad</h3>
          <form method="post" class="squad-form">
            <input type="hidden" name="action" value="create_squad" />
            <input name="name" required maxlength="60" placeholder="Raid team" aria-label="Squad name" />
            <select name="roleId" aria-label="Discord role" required>
              {roles.map((r) => <option value={r.id}>@{r.name}</option>)}
            </select>
            <button class="button secondary" type="submit">Add squad</button>
          </form>
          <p class="muted small">Members show up in a squad after their next login or Discord command.</p>
        </div>
      )}

      {inviteUrl && (
        <div>
          <h3>Invite link</h3>
          <p class="muted small">Anyone with this link can join. Reset it if it ends up somewhere it shouldn't.</p>
          <div class="invite-row">
            <input class="invite" readonly value={inviteUrl} data-select-on-click />
            <button class="button secondary" type="button" data-copy={inviteUrl}>Copy</button>
          </div>
          <form method="post">
            <input type="hidden" name="action" value="reset_invite" />
            <button class="link small" type="submit">Reset link</button>
          </form>
        </div>
      )}

      <div>
        <h3>Members</h3>
        <ul class="plain">
          {week.members.map((m) => (
            <li class="list-row">
              <span>{m.displayName}</span>
              {m.role === "admin" ? (
                <span class="muted small">Admin</span>
              ) : isAdmin && kind === "private" ? (
                <form method="post">
                  <input type="hidden" name="action" value="make_admin" />
                  <input type="hidden" name="memberId" value={m.userId} />
                  <button class="link small" type="submit">Make admin</button>
                </form>
              ) : (
                <span class="muted small">Member</span>
              )}
            </li>
          ))}
        </ul>
        {kind !== "private" && (
          <p class="muted small">Admins are the people who can manage the Discord server.</p>
        )}
      </div>

      {membership.source === "invite" && (
        <form method="post">
          <input type="hidden" name="action" value="leave" />
          <button class="button danger" type="submit">Leave group</button>
        </form>
      )}
      {kind === "squad" && isAdmin && (
        <form method="post">
          <input type="hidden" name="action" value="delete_squad" />
          <button class="button danger" type="submit">Delete squad</button>
        </form>
      )}
    </div>
  </details>
</Layout>

<script>
  for (const button of document.querySelectorAll("[data-copy]")) {
    button.addEventListener("click", async () => {
      await navigator.clipboard.writeText((button as HTMLElement).dataset.copy ?? "");
      button.textContent = "Copied";
      setTimeout(() => (button.textContent = "Copy"), 1500);
    });
  }
  for (const input of document.querySelectorAll("[data-select-on-click]")) {
    input.addEventListener("click", () => (input as HTMLInputElement).select());
  }
  for (const box of document.querySelectorAll("[data-autosubmit]")) {
    box.addEventListener("change", () => (box as HTMLInputElement).form?.requestSubmit());
  }
</script>

<style>
  .group-head {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    margin-bottom: 20px;
  }
  .group-title {
    display: flex;
    align-items: center;
    gap: 14px;
  }
  .group-title h1 {
    margin: 0;
  }
  .group-title p {
    margin: 0;
  }
  .server-icon {
    width: 52px;
    height: 52px;
    border-radius: 14px;
    flex: none;
    object-fit: cover;
  }
  .server-icon.letter {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: #a8322d;
    color: #fff;
    font-size: 22px;
    font-weight: 700;
  }
  .tabs {
    margin: 0;
    flex-wrap: wrap;
  }
  .free-strip {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 16px;
    border-radius: 12px;
    background: var(--yes-soft);
    border: 1px solid rgba(59, 163, 107, 0.35);
    margin-bottom: 16px;
  }
  .pulse {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--yes);
    box-shadow: 0 0 0 4px rgba(59, 163, 107, 0.25);
    flex: none;
  }
  .grid-box {
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
  }
  .grid {
    --name-col: 190px;
    display: grid;
    gap: 6px;
    padding: 16px;
  }
  @media (max-width: 900px) {
    .grid {
      --name-col: 130px;
      gap: 4px;
      padding: 12px;
    }
    .person .tiny {
      display: none;
    }
  }
  /* Phones get the day-by-day list instead of the grid. */
  .agenda {
    display: none;
  }
  @media (max-width: 640px) {
    .grid-box {
      display: none;
    }
    .agenda {
      display: flex;
      flex-direction: column;
      gap: 10px;
    }
  }
  .agenda-day {
    border-radius: var(--radius);
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 12px 14px;
  }
  .agenda-day.is-today {
    border-color: var(--accent);
  }
  .agenda-head {
    display: flex;
    align-items: baseline;
    gap: 10px;
  }
  .agenda-head strong {
    flex: 1;
  }
  .agenda-best {
    font-size: 18px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    background: none;
  }
  .agenda-people {
    list-style: none;
    margin: 10px 0 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }
  .agenda-people li {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: 14px;
  }
  .agenda-name {
    flex: 1 1 80px;
    min-width: 70px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-weight: 600;
  }
  .agenda-times {
    margin-left: auto;
    display: flex;
    gap: 4px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }
  .agenda-rest {
    display: flex;
    flex-direction: column;
    margin: 8px 0 0;
  }
  .col-head {
    text-align: center;
    padding: 4px 0;
    font-size: 13px;
    color: var(--muted);
  }
  .col-head.is-today {
    color: var(--accent);
  }
  .row-label {
    display: flex;
    align-items: center;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--muted);
  }
  .best {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
    padding: 8px 4px;
    border-radius: 8px;
  }
  .best-time {
    font-size: 18px;
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }
  .enough {
    background: rgba(59, 163, 107, 0.18);
    color: var(--yes-text);
  }
  .possible {
    background: rgba(217, 166, 40, 0.16);
    color: var(--maybe-text);
  }
  .none {
    color: var(--cell-muted);
  }
  .person {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 0;
  }
  .person-text {
    display: flex;
    flex-direction: column;
    line-height: 1.3;
    font-size: 14px;
  }
  .tiny {
    font-size: 12px;
  }
  .cell {
    min-width: 0;
    min-height: 52px;
    border-radius: 8px;
    background: var(--cell);
    padding: 6px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    align-items: center;
    justify-content: center;
  }
  .cell.is-today {
    box-shadow: inset 0 0 0 2px var(--accent);
  }
  .cell.is-default {
    outline: 1px dashed var(--muted);
    outline-offset: -3px;
  }
  .t-yes,
  .t-maybe {
    font-size: 13px;
    font-weight: 600;
    border-radius: 6px;
