---
import { env } from "cloudflare:workers";
import Layout from "../layouts/Layout.astro";
import { serverInstallUrl, userInstallUrl } from "../lib/discord/install.ts";

const clientId = env.DISCORD_CLIENT_ID;
const configured = clientId.length > 0;
---

<Layout title="Get the tools">
  <h1>Get the tools</h1>
  <p class="muted">Everything is optional. The website works on its own.</p>

  <section class="card">
    <h2>Discord app</h2>
    <p><strong>Add to my account</strong> lets you use <code>/avail</code>, <code>/play now</code> and <code>/delay</code> in any server or DM. No admin rights needed.</p>
    <a class="button" href={configured ? userInstallUrl(clientId) : undefined} aria-disabled={!configured}>Add to my account</a>

    <p><strong>Add to my server</strong> posts your group's availability board in a channel. Needs Manage Server.</p>
    <a class="button" href={configured ? serverInstallUrl(clientId) : undefined} aria-disabled={!configured}>Add to my server</a>

    <p class="muted">
      The bot asks for: View Channels, Send Messages, Embed Links and Use Application Commands, so it can post and
      update the board. It never reads your messages.
    </p>
    {!configured && <p class="muted">Install links appear once <code>DISCORD_CLIENT_ID</code> is set.</p>}
  </section>

  <section class="card">
    <h2>WoW addon</h2>
    <p class="muted">Coming later.</p>
  </section>
</Layout>
