{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "party-planner",
  // One Worker serves the website, the Discord interactions endpoint and the cron tick.
  "main": "./src/worker.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "party-planner",
      // Replace with the id printed by `wrangler d1 create party-planner`.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../../packages/db/migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["* * * * *"]
  },
  "vars": {
    "DISCORD_CLIENT_ID": "1563213022087090206",
    "DISCORD_PUBLIC_KEY": "91e2bee2f0364fa41c24fb7a459fcb863f01911d6f95851eaa949caa5db81ee0",
    "PUBLIC_BASE_URL": "http://localhost:4321"
  }
  // Secrets (wrangler secret put / .dev.vars): DISCORD_BOT_TOKEN, DISCORD_CLIENT_SECRET
}
